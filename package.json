{
  "name": "job-tracker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev -w @job-tracker/web",
    "dev:api": "npm run dev -w @job-tracker/api",
    "build": "npm run build -w @job-tracker/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @job-tracker/api",
    "db:migrate": "npm run db:migrate -w @job-tracker/api",
    "db:studio": "npm run db:studio -w @job-tracker/api",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "e2e": "npm run e2e -w @job-tracker/e2e",
    "e2e:ui": "npm run e2e:ui -w @job-tracker/e2e"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.7",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    }
  }
}
