# Скопируйте в .env: cp .env.example .env
# Значения базы подходят для локального Postgres из docker-compose.yml
DATABASE_URL=postgres://job_tracker:job_tracker@localhost:5433/job_tracker
TEST_DATABASE_URL=postgres://job_tracker:job_tracker@localhost:5433/job_tracker_test
PORT=3001

# Авторизация (Better Auth + Google)
# Локально фронтенд и API открываются через Vite на одном адресе
BETTER_AUTH_URL=http://localhost:5173
# Случайная строка от 32 символов: openssl rand -base64 32
BETTER_AUTH_SECRET=
# OAuth-клиент из Google Cloud Console (Google Auth Platform → Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
