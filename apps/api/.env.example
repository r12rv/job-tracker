# Скопируйте в .env: cp .env.example .env
# Значения подходят для локального Postgres из docker-compose.yml
DATABASE_URL=postgres://job_tracker:job_tracker@localhost:5433/job_tracker
TEST_DATABASE_URL=postgres://job_tracker:job_tracker@localhost:5433/job_tracker_test
PORT=3001
# CRUD вакансий: локально включён, на Vercel выключен до появления авторизации
ENABLE_VACANCIES_API=true
